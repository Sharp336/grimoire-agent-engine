{
	"name": "@oh-my-pi/pi-chatgpt-web-launcher",
	"version": "17.2.4",
	"private": true,
	"description": "Authenticated desktop browser host for Oh My Pi ChatGPT Web",
	"author": "Oh My Pi contributors",
	"license": "MIT",
	"type": "module",
	"main": "electron/main.cjs",
	"types": "src/types.ts",
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"check": "bun run test && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "node --test test/*.test.cjs",
		"dev": "vite",
		"build": "bun run check:types && vite build",
		"build:runtime": "bun scripts/prepare-runtime.cjs",
		"prepare:runtime": "bun scripts/prepare-runtime.cjs",
		"package": "bun run build && bun run build:runtime && node scripts/package.cjs",
		"smoke:package": "node scripts/smoke-package.cjs"
	},
	"dependencies": {
		"@oh-my-pi/pi-chatgpt-web": "workspace:*",
		"@oh-my-pi/pi-natives": "catalog:",
		"motion": "12.42.2",
		"playwright-core": "1.62.1",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "22.10.2",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "5.2.0",
		"electron": "41.7.1",
		"electron-builder": "26.8.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"build": {
		"appId": "sh.omp.chatgpt-web",
		"productName": "OMP ChatGPT Web",
		"artifactName": "omp-chatgpt-web-${version}-${os}-${arch}.${ext}",
		"asar": true,
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**",
			"build/provider-runtime.cjs",
			"electron/**",
			"assets/icon.png",
			"assets/icon.ico",
			"package.json"
		],
		"extraResources": [
			{
				"from": "build/runtime",
				"to": "runtime"
			}
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"icon": "assets/icon.png",
			"minimumSystemVersion": "13.0",
			"hardenedRuntime": true,
			"target": ["dmg", "zip"]
		},
		"win": {
			"icon": "assets/icon.ico",
			"target": ["nsis"]
		},
		"linux": {
			"category": "Development",
			"icon": "assets/icon.png",
			"target": ["AppImage"]
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"allowElevation": false,
			"runAfterFinish": false
		}
	}
}
