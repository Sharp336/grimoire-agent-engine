{
  "type": "module",
  "name": "@oh-my-pi/pi-chatgpt-web",
  "version": "17.2.4",
  "description": "ChatGPT Web provider and browser runtime for OMP",
  "homepage": "https://omp.sh",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/chatgpt-web"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "ai",
    "chatgpt",
    "browser",
    "provider",
    "omp"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "chatgpt-web": "./src/cli.ts"
  },
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "bun test --parallel",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@oh-my-pi/pi-ai": "catalog:",
    "@oh-my-pi/pi-catalog": "catalog:",
    "@oh-my-pi/pi-natives": "catalog:",
    "fflate": "catalog:",
    "playwright-core": "1.62.1",
    "turndown": "catalog:",
    "turndown-plugin-gfm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/turndown": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "LICENSES"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./extension": {
      "types": "./src/extension.ts",
      "import": "./src/extension.ts"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "import": "./src/cli.ts"
    }
  }
}
